includes:
    - phpstan-bootstrap.php
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/migrations/

    # Level 5 is the Phase 0 baseline. Raise to 6 once the model layer exists;
    # level 6 without models produces noise on every Eloquent call.
    level: 5

    checkModelProperties: true
    # Laravel 13 initializes casts in the constructor; infer casts() directly.
    parseModelCastsMethod: true
    checkOctaneCompatibility: false

    # No ignores. When Filament resources land in Phase 1, add patterns that
    # actually match reported errors — an unmatched pattern is itself an error.
    ignoreErrors: []
