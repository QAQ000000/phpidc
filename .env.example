# Bootstrap Infrastructure Only (charter §3.6)
# Payment, OAuth, Telegram Bot, SMTP, SMS, KYC and every business rule are
# configured in the Admin Panel (system_settings table) — never here.
#
# APP_KEY is immutable after install: changing it makes system_settings,
# upstream_apis, redemption_codes.code and instances.encrypted_credentials
# undecryptable. See docs/deployment.md for offline app:reencrypt-secrets.
# Do not put a key in command-line arguments or change APP_KEY before rotation.

APP_NAME="CloudCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloud.example.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloud_cms
DB_USERNAME=root
DB_PASSWORD=

# INV-Q1: retry_after (240s) MUST exceed the job timeout (180s), which in turn
# must exceed the slowest upstream timeout (30s). Lowering these re-introduces
# duplicate execution.
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=240

CACHE_STORE=redis
MAINTENANCE_CACHE_STORE=redis
RECEIVABLE_CHECK_CACHE_STORE=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
