# Bootstrap Infrastructure Only
# All payment, OAuth, Telegram Bot, SMTP, SMS, KYC, and business rules
# are configured dynamically in the Admin Panel (system_settings table).

APP_NAME="CloudCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloud.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloud_cms
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
