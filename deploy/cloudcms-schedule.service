[Unit]
Description=CloudCMS one-minute scheduler
After=network-online.target

[Service]
Type=oneshot
User=www
Group=www
WorkingDirectory=/www/wwwroot/Laravel13idc
ExecStart=/www/server/php/84/bin/php artisan schedule:run --no-interaction
# Supplier I/O runs in dedicated queues, never in this minute dispatcher.
TimeoutStartSec=55
UMask=0027
StandardOutput=journal
StandardError=journal
