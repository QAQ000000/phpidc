{
    "name": "cloud-cms/platform",
    "type": "project",
    "description": "AI-Agent-Friendly Cloud Product Sales CMS (Laravel 13 + Filament v5)",
    "keywords": ["laravel", "filament", "cloud", "idc"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "bezhansalleh/filament-shield": "^4.3",
        "corsinvest/cv4pve-api-php": "^9.0",
        "ezyang/htmlpurifier": "^4.17",
        "filament/filament": "^5.0",
        "laravel/socialite": "^5.16",
        "livewire/livewire": "^4.0",
        "socialiteproviders/qq": "^4.1",
        "socialiteproviders/telegram": "^4.1",
        "socialiteproviders/wechat-web": "^4.1",
        "spatie/laravel-permission": "^8.0",
        "yansongda/laravel-pay": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
